@model banSach.Models.Quyen

@{
    ViewBag.Title = "Chi Tiết Quyền";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Chi Tiết Quyền</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "HomeAdmin")">Trang Chủ</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Quyens")">Quyền</a></li>
        <li class="breadcrumb-item active">Chi Tiết</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-info-circle me-1"></i>
            Thông Tin Quyền
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Mã Quyền</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.MaQuyen)</dd>

                <dt class="col-sm-3">Tên Quyền</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.TenQuyen)</dd>

                <dt class="col-sm-3">Chức Năng</dt>
                <dd class="col-sm-9">
                    @if (Model.ChucNang != null)
                    {
                        <span class="badge bg-primary">@Model.ChucNang.TenChucNang</span>
                        <span class="text-muted ms-2">(@Model.ChucNang.MaChucNang)</span>
                    }
                </dd>

                <dt class="col-sm-3">Số Chức Vụ Được Cấp</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-info">@Model.ChucVus.Count</span>
                </dd>
            </dl>

            @if (Model.ChucVus.Any())
            {
                <hr />
                <h5>Danh Sách Chức Vụ Được Cấp Quyền Này:</h5>
                <table class="table table-sm table-bordered mt-3">
                    <thead class="table-light">
                        <tr>
                            <th>Mã Chức Vụ</th>
                            <th>Tên Chức Vụ</th>
                            <th>Số Nhân Viên</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cv in Model.ChucVus)
                        {
                            <tr>
                                <td>@cv.MaCV</td>
                                <td>@cv.TenCV</td>
                                <td>
                                    <span class="badge bg-secondary">@cv.NhanViens.Count</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="mt-4">
                <a href="@Url.Action("ManageChucVu", new { id = Model.MaQuyen })" class="btn btn-primary">
                    <i class="fas fa-users-cog"></i> Quản Lý Chức Vụ
                </a>
                <a href="@Url.Action("Edit", new { id = Model.MaQuyen })" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Sửa
                </a>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Quay Lại
                </a>
            </div>
        </div>
    </div>
</div>
