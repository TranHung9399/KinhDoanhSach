@model banSach.Models.Quyen

@{
    ViewBag.Title = "Xóa Quyền";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Xóa Quyền</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "HomeAdmin")">Trang Chủ</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Quyens")">Quyền</a></li>
        <li class="breadcrumb-item active">Xóa</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header bg-danger text-white">
            <i class="fas fa-exclamation-triangle me-1"></i>
            Xác Nhận Xóa Quyền
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <strong>Cảnh báo!</strong> Bạn có chắc chắn muốn xóa quyền này không?
            </div>

            <dl class="row">
                <dt class="col-sm-3">Mã Quyền</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.MaQuyen)</dd>

                <dt class="col-sm-3">Tên Quyền</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.TenQuyen)</dd>

                <dt class="col-sm-3">Chức Năng</dt>
                <dd class="col-sm-9">
                    @if (Model.ChucNang != null)
                    {
                        <span class="badge bg-primary">@Model.ChucNang.TenChucNang</span>
                    }
                </dd>

                <dt class="col-sm-3">Số Chức Vụ Liên Quan</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-info">@Model.ChucVus.Count</span>
                </dd>
            </dl>

            @if (Model.ChucVus.Any())
            {
                <div class="alert alert-danger mt-3">
                    <strong>Lưu ý:</strong> Quyền này đang được gán cho @Model.ChucVus.Count chức vụ. Không thể xóa!
                </div>
            }

            @using (Html.BeginForm("Delete", "Quyens", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-actions mt-4">
                    @if (!Model.ChucVus.Any())
                    {
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Xóa
                        </button>
                    }
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Quay Lại
                    </a>
                </div>
            }
        </div>
    </div>
</div>
