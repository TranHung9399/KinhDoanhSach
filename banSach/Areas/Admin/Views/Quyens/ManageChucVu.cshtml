@model banSach.Models.Quyen

@{
    ViewBag.Title = "Quản Lý Chức Vụ - " + Model.TenQuyen;
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var allChucVus = ViewBag.AllChucVus as IEnumerable<banSach.Models.ChucVu>;
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Quản Lý Chức Vụ Cho Quyền</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "HomeAdmin")">Trang Chủ</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Quyens")">Quyền</a></li>
        <li class="breadcrumb-item active">Quản Lý Chức Vụ</li>
    </ol>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Thông tin quyền -->
        <div class="col-md-12 mb-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-info-circle me-1"></i>
                    Thông Tin Quyền
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Mã Quyền:</dt>
                        <dd class="col-sm-9">@Model.MaQuyen</dd>

                        <dt class="col-sm-3">Tên Quyền:</dt>
                        <dd class="col-sm-9">@Model.TenQuyen</dd>

                        <dt class="col-sm-3">Chức Năng:</dt>
                        <dd class="col-sm-9">
                            @if (Model.ChucNang != null)
                            {
                                <span class="badge bg-primary">@Model.ChucNang.TenChucNang</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Các chức vụ đã có quyền -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-check-circle me-1"></i>
                    Các Chức Vụ Đã Có Quyền (@Model.ChucVus.Count)
                </div>
                <div class="card-body">
                    @if (Model.ChucVus.Any())
                    {
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Mã Chức Vụ</th>
                                    <th>Tên Chức Vụ</th>
                                    <th>Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cv in Model.ChucVus.OrderBy(c => c.MaCV))
                                {
                                    <tr>
                                        <td>@cv.MaCV</td>
                                        <td>@cv.TenCV</td>
                                        <td>
                                            @using (Html.BeginForm("RemoveChucVu", "Quyens", FormMethod.Post, new { style = "display:inline;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="maQuyen" value="@Model.MaQuyen" />
                                                <input type="hidden" name="maCV" value="@cv.MaCV" />
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn thu hồi quyền này?');">
                                                    <i class="fas fa-times"></i> Thu hồi
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            Chưa có chức vụ nào được cấp quyền này.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Các chức vụ chưa có quyền -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <i class="fas fa-user-plus me-1"></i>
                    Các Chức Vụ Chưa Có Quyền
                </div>
                <div class="card-body">
                    @{
                        var chuaCo = allChucVus.Where(cv => !Model.ChucVus.Any(mcv => mcv.MaCV == cv.MaCV)).ToList();
                    }

                    @if (chuaCo.Any())
                    {
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Mã Chức Vụ</th>
                                    <th>Tên Chức Vụ</th>
                                    <th>Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cv in chuaCo.OrderBy(c => c.MaCV))
                                {
                                    <tr>
                                        <td>@cv.MaCV</td>
                                        <td>@cv.TenCV</td>
                                        <td>
                                            @using (Html.BeginForm("AddChucVu", "Quyens", FormMethod.Post, new { style = "display:inline;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="maQuyen" value="@Model.MaQuyen" />
                                                <input type="hidden" name="maCV" value="@cv.MaCV" />
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="fas fa-plus"></i> Cấp quyền
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-success">
                            Tất cả chức vụ đã được cấp quyền này.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3 mb-4">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay Lại Danh Sách
        </a>
    </div>
</div>
