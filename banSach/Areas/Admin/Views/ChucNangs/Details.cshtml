@model banSach.Models.ChucNang

@{
    ViewBag.Title = "Chi Tiết Chức Năng";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Chi Tiết Chức Năng</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "HomeAdmin")">Trang Chủ</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "ChucNangs")">Chức Năng</a></li>
        <li class="breadcrumb-item active">Chi Tiết</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-info-circle me-1"></i>
            Thông Tin Chức Năng
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Mã Chức Năng</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.MaChucNang)</dd>

                <dt class="col-sm-3">Tên Chức Năng</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.TenChucNang)</dd>

                <dt class="col-sm-3">Số Quyền Liên Quan</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-info">@Model.Quyens.Count</span>
                </dd>
            </dl>

            @if (Model.Quyens.Any())
            {
                <hr />
                <h5>Danh Sách Quyền Thuộc Chức Năng Này:</h5>
                <table class="table table-sm table-bordered mt-3">
                    <thead class="table-light">
                        <tr>
                            <th>Mã Quyền</th>
                            <th>Tên Quyền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var quyen in Model.Quyens)
                        {
                            <tr>
                                <td>@quyen.MaQuyen</td>
                                <td>@quyen.TenQuyen</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="mt-4">
                <a href="@Url.Action("Edit", new { id = Model.MaChucNang })" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Sửa
                </a>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Quay Lại
                </a>
            </div>
        </div>
    </div>
</div>
