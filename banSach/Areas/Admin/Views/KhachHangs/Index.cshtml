@model IEnumerable<banSach.Models.KhachHang>

@{
    ViewBag.Title = "Quản lý khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="page-header">
        <h1><i class="fas fa-users"></i> Quản lý khách hàng</h1>
        <div class="page-actions">
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="fas fa-plus"></i> Thêm khách hàng
            </a>
            <a href="@Url.Action("ExportExcel")" class="btn btn-success">
                <i class="fas fa-file-excel"></i> Xuất Excel
            </a>
        </div>
    </div>

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "HomeAdmin")">Trang chủ</a></li>
        <li class="breadcrumb-item active">Khách hàng</li>
    </ol>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="stats-card">
                <div class="stats-card-icon bg-primary">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stats-card-title">Tổng khách hàng</div>
                <div class="stats-card-value">@Model.Count()</div>
                <div class="stats-card-change positive">
                    <i class="fas fa-arrow-up"></i> +12% so với tháng trước
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stats-card">
                <div class="stats-card-icon bg-success">
                    <i class="fas fa-user-check"></i>
                </div>
                <div class="stats-card-title">Khách hàng hoạt động</div>
                <div class="stats-card-value">@Model.Count(k => k.GioHangs.Any())</div>
                <div class="stats-card-change positive">
                    <i class="fas fa-arrow-up"></i> +8%
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stats-card">
                <div class="stats-card-icon bg-warning">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <div class="stats-card-title">Có giỏ hàng</div>
                <div class="stats-card-value">@Model.Count(k => k.GioHangs.Any())</div>
                <div class="stats-card-change">
                    <i class="fas fa-minus"></i> Không đổi
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stats-card">
                <div class="stats-card-icon bg-danger">
                    <i class="fas fa-user-plus"></i>
                </div>
                <div class="stats-card-title">Khách hàng mới (tháng này)</div>
                <div class="stats-card-value">45</div>
                <div class="stats-card-change positive">
                    <i class="fas fa-arrow-up"></i> +23%
                </div>
            </div>
        </div>
    </div>

    <!-- Search and Filter -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-search"></i> Tìm kiếm và lọc
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Index", "KhachHangs", FormMethod.Get, new { @class = "row g-3" }))
            {
                <div class="col-md-5">
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Tìm theo tên, email, số điện thoại..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="filterBy" class="form-select">
                        <option value="">Tất cả khách hàng</option>
                        <option value="active">Đang hoạt động</option>
                        <option value="inactive">Chưa mua hàng</option>
                        <option value="vip">Khách hàng VIP</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </button>
                </div>
                <div class="col-md-2">
                    <a href="@Url.Action("Index")" class="btn btn-secondary w-100">
                        <i class="fas fa-redo"></i> Đặt lại
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Customers Table -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table"></i> Danh sách khách hàng (@Model.Count() khách hàng)
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Mã KH</th>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Địa chỉ</th>
                            <th>Ngày sinh</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td data-label="Mã KH">
                                    <strong>@Html.DisplayFor(modelItem => item.MaKH)</strong>
                                </td>
                                <td data-label="Họ tên">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle">
                                            @(item.HoTen?.Substring(0, 1).ToUpper() ?? "?")
                                        </div>
                                        @Html.DisplayFor(modelItem => item.HoTen)
                                    </div>
                                </td>
                                <td data-label="Email">
                                    <i class="fas fa-envelope text-muted"></i>
                                    @Html.DisplayFor(modelItem => item.Email)
                                </td>
                                <td data-label="Số điện thoại">
                                    <i class="fas fa-phone text-muted"></i>
                                    @Html.DisplayFor(modelItem => item.SoDienThoai)
                                </td>
                                <td data-label="Địa chỉ">
                                    <div style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@item.DiaChi">
                                        <i class="fas fa-map-marker-alt text-muted"></i>
                                        @Html.DisplayFor(modelItem => item.DiaChi)
                                    </div>
                                </td>
                                <td data-label="Ngày sinh">
                                    @if (item.NgaySinh.HasValue)
                                    {
                                        <i class="fas fa-birthday-cake text-muted"></i>
                                        @item.NgaySinh.Value.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa cập nhật</span>
                                    }
                                </td>
                                <td data-label="Trạng thái">
                                    @if (item.TrangThai == 1)
                                    {
                                        <span class="badge badge-success">
                                            <i class="fas fa-check-circle"></i> Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">
                                            <i class="fas fa-times-circle"></i> Vô hiệu hóa
                                        </span>
                                    }
                                </td>
                                <td data-label="Thao tác">
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("Details", new { id = item.MaKH })" class="btn btn-sm btn-outline-info" title="Chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Edit", new { id = item.MaKH })" class="btn btn-sm btn-outline-primary" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <a href="@Url.Action("ToggleStatus", new { id = item.MaKH })"
                                           class="btn btn-sm btn-outline-warning"
                                           title="@(item.TrangThai == 1 ? "Vô hiệu hóa tài khoản" : "Kích hoạt tài khoản")"
                                           onclick="return confirm('Bạn có chắc muốn thay đổi trạng thái?')">
                                            <i class="fas fa-@(item.TrangThai == 1 ? "ban" : "check")"></i>
                                        </a>

                                        <a href="@Url.Action("Delete", new { id = item.MaKH })"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Xóa"
                                           onclick="return confirm('Bạn có chắc muốn xóa sách này?')">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
    }

    .btn-group .btn {
        padding: 6px 12px;
        font-size: 14px;
    }

    .btn-group .btn i {
        margin: 0;
    }
</style>