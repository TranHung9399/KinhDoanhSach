@model banSach.Models.MaGiamGia

@{
    ViewBag.Title = "Xóa Mã giảm giá";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var now = DateTime.Now;
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="page-header">
        <h1><i class="fas fa-trash-alt"></i> Xóa Mã giảm giá</h1>
    </div>

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "HomeAdmin")">Trang chủ</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index")">Mã giảm giá</a></li>
        <li class="breadcrumb-item active">Xóa</li>
    </ol>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow mb-4 border-danger">
                <div class="card-header py-3 bg-danger text-white">
                    <h6 class="m-0 font-weight-bold">
                        <i class="fas fa-exclamation-triangle"></i> Xác nhận xóa mã giảm giá
                    </h6>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger" role="alert">
                        <i class="fas fa-exclamation-circle fa-2x float-left mr-3"></i>
                        <h5 class="alert-heading">Cảnh báo!</h5>
                        <p>Bạn có chắc chắn muốn xóa mã giảm giá này? Hành động này không thể hoàn tác.</p>
                    </div>

                    <h5 class="mb-3">
                        <i class="fas fa-info-circle text-primary"></i> Thông tin mã giảm giá sẽ bị xóa:
                    </h5>

                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="text-muted">
                                        <i class="fas fa-barcode"></i> Mã Code
                                    </label>
                                    <div>
                                        <h5 class="text-primary">
                                            <strong>@Model.MaCode</strong>
                                        </h5>
                                    </div>
                                </div>
                                <div class="col-md-8">
                                    <label class="text-muted">
                                        <i class="fas fa-tag"></i> Tên chương trình
                                    </label>
                                    <div>
                                        <h6>@Model.TenChuongTrinh</h6>
                                    </div>
                                </div>
                            </div>

                            <hr />

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="text-muted">
                                        <i class="fas fa-percent"></i> Giá trị giảm
                                    </label>
                                    <div>
                                        @if (Model.PhanTramGiam.HasValue && Model.PhanTramGiam.Value > 0)
                                        {
                                            <span class="badge badge-success badge-lg">
                                                <i class="fas fa-percent"></i> @Model.PhanTramGiam%
                                            </span>
                                        }
                                        else if (Model.SoTienGiam.HasValue && Model.SoTienGiam.Value > 0)
                                        {
                                            <span class="badge badge-info badge-lg">
                                                <i class="fas fa-money-bill-wave"></i> @Model.SoTienGiam.Value.ToString("N0")đ
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Không có</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted">
                                        <i class="fas fa-info-circle"></i> Trạng thái
                                    </label>
                                    <div>
                                        @if (Model.NgayKetThuc < now)
                                        {
                                            <span class="badge badge-secondary badge-lg">
                                                <i class="fas fa-ban"></i> Đã hết hạn
                                            </span>
                                        }
                                        else if (Model.NgayBatDau > now)
                                        {
                                            <span class="badge badge-warning badge-lg">
                                                <i class="fas fa-clock"></i> Sắp diễn ra
                                            </span>
                                        }
                                        else if ((Model.DaSuDung ?? 0) >= (Model.SoLuongMa ?? 0))
                                        {
                                            <span class="badge badge-danger badge-lg">
                                                <i class="fas fa-times-circle"></i> Hết lượt
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success badge-lg">
                                                <i class="fas fa-check-circle"></i> Hoạt động
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <hr />

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="text-muted">
                                        <i class="fas fa-calendar"></i> Thời gian
                                    </label>
                                    <div>
                                        <small>
                                            <i class="fas fa-calendar-check text-success"></i>
                                            @(Model.NgayBatDau.HasValue ? Model.NgayBatDau.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                                        </small>
                                        <br />
                                        <small>
                                            <i class="fas fa-calendar-times text-danger"></i>
                                            @(Model.NgayKetThuc.HasValue ? Model.NgayKetThuc.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                                        </small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted">
                                        <i class="fas fa-users"></i> Lượt sử dụng
                                    </label>
                                    <div>
                                        <strong>@(Model.DaSuDung ?? 0)</strong> / <strong>@(Model.SoLuongMa ?? 0)</strong>
                                        <div class="progress mt-2" style="height: 20px;">
                                            @{
                                                var percentage = (Model.SoLuongMa ?? 0) > 0 ? ((Model.DaSuDung ?? 0) * 100.0 / (Model.SoLuongMa ?? 0)) : 0;
                                            }
                                            <div class="progress-bar @(percentage >= 100 ? "bg-danger" : percentage >= 80 ? "bg-warning" : "bg-success")"
                                                 role="progressbar"
                                                 style="width: @percentage%">
                                                @percentage.ToString("0")%
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if ((Model.DaSuDung ?? 0) > 0)
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>Lưu ý:</strong> Mã giảm giá này đã được sử dụng <strong>@(Model.DaSuDung ?? 0)</strong> lần.
                            Việc xóa có thể ảnh hưởng đến dữ liệu lịch sử đơn hàng.
                        </div>
                    }

                    @using (Html.BeginForm("Delete", "MaGiamGias", FormMethod.Post, new { @class = "mt-4" }))
                    {
                        @Html.AntiForgeryToken()

                        <hr />

                        <div class="form-group text-center">
                            <button type="submit" class="btn btn-danger btn-lg" onclick="return confirm('Bạn có THỰC SỰ chắc chắn muốn xóa mã giảm giá này?')">
                                <i class="fas fa-trash-alt"></i> Xác nhận xóa
                            </button>
                            <a href="@Url.Action("Details", new { id = Model.MaCode })" class="btn btn-info btn-lg">
                                <i class="fas fa-eye"></i> Xem chi tiết
                            </a>
                            <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">
                                <i class="fas fa-times"></i> Hủy bỏ
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .badge-lg {
            font-size: 1rem;
            padding: 0.5rem 0.75rem;
        }
    </style>
}
