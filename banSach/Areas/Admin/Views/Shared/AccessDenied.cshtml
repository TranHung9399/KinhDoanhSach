@{
    ViewBag.Title = "Truy Cập Bị Từ Chối";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="access-denied-container">
    <div class="access-denied-content">
        <div class="access-denied-icon">
            <i class="fas fa-lock"></i>
        </div>
        
        <h1 class="access-denied-title">@ViewBag.ErrorTitle</h1>
        
        <div class="access-denied-message">
            @Html.Raw(ViewBag.ErrorMessage)
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.FunctionCode as string))
        {
            <div class="access-denied-details">
                <p><strong>Mã chức năng:</strong> @ViewBag.FunctionCode</p>
                @if (!string.IsNullOrEmpty(ViewBag.FunctionName as string))
                {
                    <p><strong>Tên chức năng:</strong> @ViewBag.FunctionName</p>
                }
            </div>
        }

        <div class="access-denied-info">
            <i class="fas fa-info-circle"></i>
            Để được cấp quyền truy cập, vui lòng liên hệ Quản trị viên hệ thống.
        </div>

        <div class="access-denied-actions">
            <a href="@Url.Action("Index", "HomeAdmin", new { area = "Admin" })" class="btn btn-primary btn-lg">
                <i class="fas fa-home"></i> Về Trang Chủ
            </a>
            <a href="javascript:history.back()" class="btn btn-secondary btn-lg">
                <i class="fas fa-arrow-left"></i> Quay Lại
            </a>
        </div>

        <div class="access-denied-contact">
            <p class="text-muted">
                <i class="fas fa-envelope"></i> Email: admin@example.com<br>
                <i class="fas fa-phone"></i> Hotline: 1900-xxxx
            </p>
        </div>
    </div>
</div>

<style>
    .access-denied-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .access-denied-content {
        background: white;
        border-radius: 20px;
        padding: 3rem;
        max-width: 600px;
        width: 100%;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        text-align: center;
        animation: fadeInUp 0.5s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .access-denied-icon {
        width: 120px;
        height: 120px;
        margin: 0 auto 2rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: pulse 2s infinite;
    }

    .access-denied-icon i {
        font-size: 60px;
        color: white;
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.05);
        }
    }

    .access-denied-title {
        font-size: 2rem;
        font-weight: bold;
        color: #333;
        margin-bottom: 1rem;
    }

    .access-denied-message {
        font-size: 1.1rem;
        color: #666;
        margin-bottom: 2rem;
        line-height: 1.6;
    }

    .access-denied-details {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        text-align: left;
    }

    .access-denied-details p {
        margin: 0.5rem 0;
        color: #555;
    }

    .access-denied-details strong {
        color: #333;
        margin-right: 0.5rem;
    }

    .access-denied-info {
        background: #fff3cd;
        border: 1px solid #ffc107;
        border-radius: 10px;
        padding: 1rem;
        margin-bottom: 2rem;
        color: #856404;
    }

    .access-denied-info i {
        margin-right: 0.5rem;
    }

    .access-denied-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .access-denied-actions .btn {
        min-width: 150px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .access-denied-actions .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }

    .access-denied-actions .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(102, 126, 234, 0.4);
    }

    .access-denied-actions .btn-secondary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    }

    .access-denied-contact {
        padding-top: 2rem;
        border-top: 1px solid #e0e0e0;
    }

    .access-denied-contact p {
        margin: 0;
        line-height: 1.8;
    }

    .access-denied-contact i {
        margin-right: 0.5rem;
        color: #667eea;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .access-denied-content {
            padding: 2rem 1.5rem;
        }

        .access-denied-title {
            font-size: 1.5rem;
        }

        .access-denied-actions {
            flex-direction: column;
        }

        .access-denied-actions .btn {
            width: 100%;
        }
    }
</style>

<script>
    // Auto-focus vào nút "Về Trang Chủ" khi load trang
    document.addEventListener('DOMContentLoaded', function() {
        const homeButton = document.querySelector('.access-denied-actions .btn-primary');
        if (homeButton) {
            homeButton.focus();
        }
    });
</script>
