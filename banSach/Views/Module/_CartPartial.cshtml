@model IEnumerable<banSach.Models.ChiTietGioHang>

<div class="shopping-item-dropdown">
    <ul class="shopping-list">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <li>
                    <a href="@Url.Action("XoaGioHang", "GioHang", new { @MaSach = item.Sach.MaSach })" class="remove" title="Xóa sản phẩm"><i class="fa fa-remove"></i></a>

                    <a class="cart-img" href="@Url.Action("Details", "Book", new { id = item.Sach.MaSach })">
                        <img src="~/img/sach/@item.Sach.Hinh" alt="@item.Sach.TenSach">
                    </a>

                    <h4><a href="@Url.Action("Details", "Book", new { id = item.Sach.MaSach })">@item.Sach.TenSach</a></h4>

                    <p class="quantity">@item.SoLuong x - <span class="amount">@String.Format("{0:0,0}", item.Sach.GiaChietKhau.GetValueOrDefault(0)) VNĐ</span></p>
                </li>
            }
        }
        else
        {
            <li style="text-align: center; padding: 20px 0;">Giỏ hàng của bạn đang trống.</li>
        }
    </ul>
    <div class="shopping-total">
        <span>Tổng cộng:</span>
        <span class="total-amount">@String.Format("{0:0,0}", (decimal)ViewBag.TongThanhTienDropdown) VNĐ</span>
    </div>
    <div class="shopping-buttons">
        <a href="@Url.Action("Checkout", "GioHang")" class="btn btn-primary">Thanh Toán</a>
    </div>
</div>