<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name='copyright' content=''>
    <!-- CSS -->
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="~/img/logo/logoo.jpg">
    <link rel="stylesheet" href="~/Content/bootstrap.css">
    <link rel="stylesheet" href="~/Content/magnific-popup.min.css">
    <link rel="stylesheet" href="~/Content/jquery.fancybox.min.css">
    <link rel="stylesheet" href="~/Content/niceselect.css">
    <link rel="stylesheet" href="~/Content/animate.css">
    <link rel="stylesheet" href="~/Content/flex-slider.min.css">
    <link rel="stylesheet" href="~/Content/owl-carousel.css">
    <link rel="stylesheet" href="~/Content/slicknav.min.css">
    <link rel="stylesheet" href="~/Content/reset.css">
    <link rel="stylesheet" href="~/Content/css.css">
    <link rel="stylesheet" href="~/Content/thongbao1.css">
    <link rel="stylesheet" href="~/Content/responsive.css">
    <link rel="stylesheet" href="~/Content/Site.css">
    <link rel="stylesheet" href="~/css/layout.css">
    <link rel="stylesheet" href="~/Content/layout-custom.css">
    <link rel="stylesheet" href="~/Content/chatbot.css">
    <link rel="stylesheet" href="~/Content/wishlist-sidebar.css">
    <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/themify-icons/1.0.0/css/themify-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-Avb2QiuDEEvB4bZJYdft2mNjVShBftLdPG8FJ0V7irTLQ8Uo0qcPxh4Plq7G5tGm0rU+1SPhVotteLpBERwTkw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- JS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js" defer></script>
</head>
<body>
    @Html.AntiForgeryToken()
    @Html.Partial("_CustomToast")
    <!-- Header -->
    <header class="header shop">
        <!-- Topbar -->
        <div class="topbar">
            <div class="container">
                <div class="row">
                    <div class="col-lg-5 col-md-12 col-12">
                        <div class="top-left">
                            <ul class="list-main">
                                <li><i class="bx bx-headphone"></i> +123 456 7891</li>
                                <li><i class="bx bx-envelope"></i> info@bookstore.com</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-7 col-md-12 col-12">
                        <div class="right-content">
                            <ul class="list-main">
                                <li><i class="bx bx-map"></i> Sơn Trà, Đà Nẵng</li>
                                @if (Session["KhachHang"] == null || string.IsNullOrEmpty(Session["KhachHang"]?.ToString()))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" href="@Url.Action("Index", "Dangnhap")">
                                            <i class="bx bx-log-in"></i> Đăng Nhập
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" href="@Url.Action("Index", "Dangky")">
                                            <i class="bx bx-user-plus"></i> Đăng Ký
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="nav-item">
                                        <span class="nav-link">
                                            <a href="@Url.Action("Index", "Thongtin")" title="Xem/Chỉnh sửa thông tin">
                                                <i class="bx bx-user-circle"> @Session["HoTen"]</i>
                                            </a>
                                        </span>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" href="@Url.Action("Logout", "DangNhap")" title="Đăng xuất">
                                            <i class="bx bx-log-out"></i> Thoát
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- End Topbar -->
        <div class="middle-inner">
            <div class="container">
                <div class="row">
                    <div class="col-lg-2 col-md-2 col-12">
                        <div class="logo">
                            <a href="@Url.Action("Index", "Home")"><img src="~/img/logo/logoo.jpg" alt="logo"></a>
                        </div>
                        <div class="search-top"></div>
                        <div class="mobile-nav"></div>
                    </div>
                    <div class="col-lg-8 col-md-7 col-12">
                        <div class="search-bar-top">
                            <div class="search-bar">
                                @using (Html.BeginForm("TimKiem", "Home"))
                                {
                                    <input name="skey" placeholder="Nhập thông tin tìm kiếm....." type="text">
                                    <button class="btnn" type="submit"><i class="bx bx-search"></i></button>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-3 col-12">
                        <div class="right-bar" style="display: flex; gap: 10px;">
                            @*@if (Session["KhachHang"] != null && !string.IsNullOrEmpty(Session["KhachHang"]?.ToString()))
                                {
                                    <div class="sinlge-bar" style="display: flex; align-items: center; justify-content: center;">
                                        <a href="@Url.Action("Index", "YeuThich")" class="single-icon" title="Yêu thích">
                                            <i class="bx bx-heart" style="color: #dc3545;"></i>
                                        </a>
                                    </div>
                                }*@
                            <div class="sinlge-bar shopping" style="display: flex; align-items: center; justify-content: center; position: relative;">
                                <a href="@Url.Action("Index", "Giohang")" class="single-icon">
                                    <i class="bx bx-cart"></i>
                                    @if (ViewBag.Tongsoluong != null && ViewBag.Tongsoluong > 0)
                                    {
                                        <span class="total-count">@ViewBag.Tongsoluong</span>
                                    }
                                </a>
                                @Html.Action("_CartPartial", "Module")
                                <div class="total-count-container">
                                    <div style="font-weight: bold; font-size: 16px; margin-left: 15px; color: #222;">Giỏ hàng</div>
                                    <div style="font-size: 11px; color: #222; margin-left: 15px; font-weight: 400; display: flex; gap: 4px; align-items: center;">
                                        <span>@ViewBag.Tongsoluong</span>
                                        <span>sản phẩm</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Header Inner -->
        @Html.Action("Menu", "Module")
        <!--/ End Header Inner -->
    </header>

    <div class="product-area section">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div>
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Start Footer Area -->
    <footer class="footer">
        <div class="container">
            <!-- Col 1: Logo & Contact -->
            <div class="footer-col">
                <div class="footer-logo">
                    <img src="~/img/logo/logoo.jpg" alt="Hiệu sách Cú vọ Logo" />
                </div>
                <ul class="footer-contact">
                    <li><i class="fa fa-map-marker-alt"></i>Sơn Trà, Đà Nẵng </li>
                    <li><i class="fa fa-phone"></i> Hotline: 01 2345 5678</li>
                    <li><i class="fa fa-envelope"></i> Email: bookstore.online@gmail.com</li>
                </ul>
            </div>
            <!-- Col 2: Support -->
            <div class="footer-col">
                <div class="footer-title">HỖ TRỢ KHÁCH HÀNG</div>
                <ul class="footer-links">
                    <li><a href="#">Câu hỏi thường gặp</a></li>
                    <li><a href="#">Điều khoản dịch vụ</a></li>
                </ul>
                <div class="footer-title">ĐĂNG KÝ NHẬN TIN</div>
                <p class="footer-news-desc">
                    Hãy nhập email của bạn vào ô dưới đây để có thể nhận được tất cả tin tức mới nhất của IPM
                </p>
                <form class="footer-newsletter-form" autocomplete="off">
                    <input type="email" placeholder="Nhập email của bạn..." required />
                    <button type="submit">ĐĂNG KÝ</button>
                </form>
            </div>
            <!-- Col 3: Policies -->
            <div class="footer-col">
                <div class="footer-title">CHÍNH SÁCH</div>
                <ul class="footer-policies">
                    <li><a href="#">Chính sách bảo mật</a></li>
                    <li><a href="#">Chính sách thanh toán</a></li>
                    <li><a href="#">Chính sách vận chuyển</a></li>
                    <li><a href="#">Chính sách đổi trả</a></li>
                </ul>
            </div>
            <!-- Col 4: Social -->
            <div class="footer-col">
                <div class="footer-title">KẾT NỐI VỚI CHÚNG TÔI</div>
                <div class="fb-page">
                    <img src="~/img/logo/fb-page-demo.png" alt="Facebook Page" style="width:220px; border-radius:6px;" />
                </div>
                <div class="footer-title" style="margin-top:18px;">CÁC KÊNH KHÁC</div>
                <div class="footer-social">
                    <a href="#"><i class="fab fa-facebook-square"></i></a>
                    <a href="#"><i class="fab fa-twitter-square"></i></a>
                    <a href="#"><i class="fab fa-youtube-square"></i></a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            © @DateTime.Now.Year BOOKSTORE. All rights reserved.
        </div>
    </footer>
    @if (Session["KhachHang"] != null)
    {
        <!-- Overlay để đóng sidebar khi click bên ngoài -->
        <div class="like-offcanvas-overlay"></div>

        <div class="like-float-btn">
            <div class="icon-part">
                <i class="bx bx-heart"></i>
            </div>
            <div class="text-part">
                <span>Yêu thích</span>
            </div>
        </div>

        <div class="like-offcanvas">
            <div class="like-offcanvas-header">
                <h5>Sản Phẩm Yêu Thích</h5>
                <button type="button" class="like-close-btn">&times;</button>
            </div>
            <div class="like-offcanvas-body">
                @Html.Action("_WishlistPartial", "Module")
            </div>
        </div>

        <!-- Nút Gợi ý sách -->
        <div class="suggest-float-btn">
            <div class="icon-part">
                <i class="bx bx-book-open"></i>
            </div>
            <div class="text-part">
                <span>Gợi ý sách</span>
            </div>
        </div>
    }


    <button id="chatbot-toggler" title="Chat với Con Cú Vợ">
        <i class="fa fa-comments" style="font-size: 24px;"></i>
    </button>

    <div id="chatbot-container">
        <div class="chat-header">
            <div style="display:flex; align-items:center; gap:10px;">
                <i class="fa fa-owl" style="font-size: 20px;"></i>
                <span>Trợ Lý Con Cú Vợ</span>
            </div>
            <button onclick="toggleChat()" style="background:none; border:none; color:white; font-size:20px; cursor:pointer;">&times;</button>
        </div>

        <div class="chat-body" id="chat-box">
            <div class="message bot-message">
                Xin chào! 👋 Mình là trợ lý ảo của Hiệu Sách Con Cú Vợ.<br>
                Mình có thể giúp bạn tìm sách, tra cứu đơn hàng hoặc săn mã giảm giá nhé! 📚🦉
            </div>
        </div>

        <div class="typing-indicator" id="typing-indicator">Đang soạn tin...</div>

        <div class="chat-footer">
            <input type="text" id="chat-input" placeholder="Nhập câu hỏi (VD: Tìm sách Conan)..." autocomplete="off">
            <button onclick="sendMessage()"><i class="fa fa-paper-plane"></i></button>
        </div>
    </div>

    
    <!-- Jquery -->
    <script src="~/Scripts/jquery.min.js" defer></script>
    <script src="~/Scripts/jquery-migrate-3.0.0.js" defer></script>
    <script src="~/Scripts/jquery-ui.min.js" defer></script>
    <!-- Popper JS -->
    <script src="~/Scripts/popper.min.js" defer></script>
    <!-- Bootstrap JS -->
    <script src="~/Scripts/bootstrap.min.js" defer></script>
    <!-- Color JS -->
    <script src="~/Scripts/colors.js" defer></script>
    <!-- Slicknav JS -->
    <script src="~/Scripts/slicknav.min.js" defer></script>
    <!-- Owl Carousel JS -->
    <script src="~/Scripts/owl-carousel.js" defer></script>
    <!-- Magnific Popup JS -->
    <script src="~/Scripts/magnific-popup.js" defer></script>
    <!-- Waypoints JS -->
    <script src="~/Scripts/waypoints.min.js" defer></script>
    <!-- Countdown JS -->
    <script src="~/Scripts/finalcountdown.min.js" defer></script>
    <!-- Nice Select JS -->
    <script src="~/Scripts/nicesellect.js" defer></script>
    <!-- Flex Slider JS -->
    <script src="~/Scripts/flex-slider.js" defer></script>
    <!-- ScrollUp JS -->
    <script src="~/Scripts/scrollup.js" defer></script>
    <!-- Onepage Nav JS -->
    <script src="~/Scripts/onepage-nav.min.js" defer></script>
    <script src="~/Scripts/easing.js" defer></script>
    <script src="~/Scripts/active.js" defer></script>
    <script src="~/Scripts/layout-main.js" defer></script>
    @Scripts.Render("~/bundles/jquery") @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>